# Copy to .env and fill in. Share real values through a password manager, never in chat or git.

# Meta Model API (SAM 3.1, Muse Spark, Muse Image). Base URL: https://api.meta.ai/v1
MODEL_API_KEY=

# GPU hosting partners (3D body model)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# WhatsApp Business test number
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Public address of this server (https), used in the links sent over WhatsApp. No trailing slash.
PUBLIC_BASE_URL=
# Optional. An approved message template, needed to start a conversation. It should have one body variable
# {{1}} for the link (set WHATSAPP_TEMPLATE_VARS=0 for a template with none, e.g. Meta's hello_world).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_VARS=1
# Numbers starting with a single 0 are treated as local and get this country code (234 = Nigeria).
WHATSAPP_DEFAULT_COUNTRY_CODE=234

# Private photo storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# API
API_PORT=8000

# Tailor accounts. Tailors sign up on the dashboard; set ALLOW_SIGNUP=0 to switch sign-up off.
ALLOW_SIGNUP=1
# Optional: a demo account for judges, created with sample customers on first login (password can't be changed in the app).
DEMO_EMAIL=demo@tailorfit.app
DEMO_PASSWORD=
# Optional, older setups: an account with this login is created on first login and takes over customers from before accounts.
TAILOR_USERNAME=
TAILOR_PASSWORD=
