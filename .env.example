# Copy to .env and fill in. Share real values through a password manager, never in chat or git.

# Meta Model API (SAM 3.1, Muse Spark, Muse Image). Base URL: https://api.meta.ai/v1
MODEL_API_KEY=

# GPU hosting partners (3D body model)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# WhatsApp Business test number
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Private photo storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# API
API_PORT=8000
DEMO_JUDGE_LOGIN=

# Tailor dashboard login. There is no default: if these are empty the dashboard stays switched off.
TAILOR_USERNAME=
TAILOR_PASSWORD=
